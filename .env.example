# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Playwright MCP server launched over stdio by the Python MCP client.
MCP_SERVER_COMMAND=npx
MCP_SERVER_ARGS=-y @playwright/mcp@0.0.83 --headless --isolated

# Optional tuning
DB_PATH=data/scholarships.db
MAX_PAGES_PER_SEARCH=8
MAX_FOLLOW_LINKS_PER_PAGE=3
PAGE_TIMEOUT_SECONDS=25
CACHE_TTL_HOURS=24
FRESHNESS_DAYS=14
# Comma-separated extra domains you have verified as official scholarship providers
TRUSTED_PROVIDER_DOMAINS=
# Comma-separated extra official pages to always read first (state portals, university scholarship pages)
EXTRA_SEED_URLS=
